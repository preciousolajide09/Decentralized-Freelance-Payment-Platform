// Prisma schema for Stellar Freelance Payment Platform
// Run: prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Users — identified by their Stellar public key (G...)
// ---------------------------------------------------------------------------
model User {
  id           String   @id @default(cuid())
  stellarAddress String @unique
  displayName  String?
  email        String?
  bio          String?
  notifyOnDispute Boolean @default(false)
  notifyOnRelease Boolean @default(false)
  notifyOnRefund  Boolean @default(false)
  createdAt    DateTime @default(now())

  jobsAsClient     Job[]      @relation("ClientJobs")
  jobsAsFreelancer Job[]      @relation("FreelancerJobs")
  proposals        Proposal[] @relation("FreelancerProposals")
  uploadedDeliverables Deliverable[] @relation("UploadedDeliverables")
  ratingsGiven     Rating[]   @relation("RatingsGiven")
  ratingsReceived  Rating[]   @relation("RatingsReceived")
  savedJobs        SavedJob[]
  notifications    Notification[] @relation("UserNotifications")
  messagesSent     Message[]  @relation("MessagesSent")
  sessions         UserSession[] @relation("UserSessions")
}

// ---------------------------------------------------------------------------
// Jobs — mirrors on-chain escrow, enriched with off-chain metadata
// ---------------------------------------------------------------------------
model Job {
  id              String    @id @default(cuid())
  /// On-chain escrow ID returned by escrow.create()
  escrowId        BigInt?   @unique
  title           String
  description     String
  status          JobStatus @default(CREATED)
  /// Asset symbol the job pays in (see lib/assets.ts)
  asset           String    @default("USDC")
  /// Curated skill tags (slugs from lib/tags.ts, issue #70)
  tags            String[]  @default([])

  clientId        String
  client          User      @relation("ClientJobs", fields: [clientId], references: [id])

  freelancerId    String?
  freelancer      User?     @relation("FreelancerJobs", fields: [freelancerId], references: [id])

  /// Sum of the milestones, in whole units of `asset` — not USDC (issue #41).
  /// The asset's decimals live in lib/assets.ts; a job paying XLM stores XLM
  /// here, and a job paying a SAC stores that SAC's units.
  totalAmount     Decimal
  milestones      Milestone[]
  disputes        Dispute[]
  ratings         Rating[]
  savedBy         SavedJob[]
  messages        Message[]
  proposals       Proposal[]

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  expiresAt       DateTime?

  // GET /api/jobs: `WHERE status = ? ORDER BY createdAt DESC LIMIT/OFFSET`.
  // A composite index serves filter + ordering in one range scan (issue #92).
  @@index([status, createdAt])
  // GET /api/jobs?client=… / ?freelancer=… join through these FKs, and
  // GET /api/users/:address counts jobsAsClient / jobsAsFreelancer by them.
  @@index([clientId])
  @@index([freelancerId])
  // GET /api/jobs?tag=… filters with array containment (`tags @> ARRAY[?]`),
  // which GIN serves and a btree on an array column would not.
  @@index([tags(ops: ArrayOps)], type: Gin)
}

enum JobStatus {
  CREATED
  FUNDED
  ACTIVE
  COMPLETED
  DISPUTED
  REFUNDED
}

// ---------------------------------------------------------------------------
// Milestones
// ---------------------------------------------------------------------------
model Milestone {
  id          String          @id @default(cuid())
  jobId       String
  job         Job             @relation(fields: [jobId], references: [id])
  index       Int
  /// This milestone's amount, in whole units of the job's `asset` — not USDC
  /// (issue #41). Matches the `amount` field in the API request body.
  amount      Decimal
  description String?
  /// True when the indexed chain event lacks per-milestone data and the
  /// off-chain breakdown no longer matches the on-chain count and total.
  isStale     Boolean         @default(false)
  status      MilestoneStatus @default(PENDING)
  deadline    DateTime?
  releasedAt  DateTime?
  /// Amount released so far, in the same human units as `amount`.
  ///
  /// `escrow.release_partial` pays a milestone down over several events, each
  /// emitting the same `milestone_released` event as a full release, so the
  /// indexer needs a running total to tell the two apart and to know when the
  /// milestone is actually done (issue #25). A `RELEASED` status alone cannot
  /// carry that: it is binary.
  releasedAmount Decimal @default(0)

  deliverables Deliverable[]

  // Every `include: { milestones: true }` (job list/detail, escrow routes,
  // indexer milestone-release handling) joins on jobId.
  @@unique([jobId, index])
  @@index([jobId])
}

enum MilestoneStatus {
  PENDING
  RELEASED
}

// ---------------------------------------------------------------------------
// Disputes
// ---------------------------------------------------------------------------
model Dispute {
  id               String        @id @default(cuid())
  /// On-chain dispute ID from dispute contract
  onChainId        BigInt?       @unique
  /// One dispute per job, which is the invariant the contracts already enforce:
  /// `dispute.raise` stores `EscrowDispute(escrow_id)` and returns
  /// `AlreadyRaised` for a second raise, and a job has exactly one escrow.
  ///
  /// Unique rather than merely indexed because the row is written twice by two
  /// different writers: `POST /api/disputes` creates it (with the reason, since
  /// the `Raised` event carries none) before an on-chain id exists, and the
  /// indexer's `raised` handler / `POST /:id/sync` attach the id afterwards.
  /// Keying that second write on the job instead of on the id is what keeps a
  /// disputed job from ending up with two rows — the bug fixed in #86. It is
  /// also the unique key the indexer upserts on.
  jobId            String        @unique
  job              Job           @relation(fields: [jobId], references: [id])
  raisedByAddress  String
  reason           String
  /// PENDING until `POST /:id/sync` or the indexer's `raised` handler attaches
  /// the on-chain id. A PENDING row is an intent, not a dispute: the API hides
  /// it from every user-facing read so a transaction that was built but never
  /// submitted leaves no dispute behind (#32).
  status           DisputeStatus @default(PENDING)
  clientShare      Decimal?
  freelancerShare  Decimal?
  resolvedAt       DateTime?
  createdAt        DateTime      @default(now())

  // No @@index([jobId]): GET /api/jobs/:id `include: { disputes: true }` and the
  // indexer's `dispute.updateMany({ where: { job: { escrowId } } })` both read by
  // jobId, and the unique constraint above is that index.
}

enum DisputeStatus {
  /// The off-chain intent exists, but `dispute.raise` has not been confirmed.
  /// Never user-visible on its own.
  PENDING
  /// `dispute.raise` confirmed; the on-chain id is recorded.
  RAISED
  UNDER_REVIEW
  /// A panel ruled and the escrow was resolved with a split.
  RESOLVED
  /// The escrow was refunded (expiry or dispute timelock) with no ruling.
  /// Terminal: a refunded dispute is no longer open.
  REFUNDED
}

// ---------------------------------------------------------------------------
// Ratings — mirrors on-chain reputation contract
// ---------------------------------------------------------------------------
model Rating {
  id         String   @id @default(cuid())
  jobId      String
  job        Job      @relation(fields: [jobId], references: [id])
  raterId    String
  rater      User     @relation("RatingsGiven", fields: [raterId], references: [id])
  rateeId    String
  ratee      User     @relation("RatingsReceived", fields: [rateeId], references: [id])
  score      Int      // 1–5
  comment    String?
  createdAt  DateTime @default(now())

  // GET /api/jobs/:id `include: { ratings: true }` joins on jobId.
  @@index([jobId])
  // GET /api/reputation/:address aggregates `WHERE rateeId = ?` (via stellarAddress).
  @@index([rateeId])
  // Ratings submitted by a rater (issue #92; also the prefix of the unique below).
  @@index([raterId])

  @@unique([raterId, jobId])
}

// ---------------------------------------------------------------------------
// SavedJob — a bookmark on a job, for the user who saved it
//
// Personal and off-chain: nothing about saving a job touches the escrow, so it
// is a plain join row. Unique on (user, job) because the toggle must be
// idempotent — saving twice is the same as saving once, and unsaving a job that
// was never saved is not an error (issue #71).
// ---------------------------------------------------------------------------
model SavedJob {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])
  createdAt DateTime @default(now())

  // GET /api/jobs/saved reads one user's bookmarks newest-first; the unique key
  // below is what makes the save idempotent.
  @@unique([userId, jobId])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Messages — the job-scoped conversation between its two participants
//
// Scoped to a job and readable only by that job's client and freelancer: the
// routes resolve the caller against those two addresses before touching a row.
// A message has exactly one recipient (the other party), so one `readAt`
// tracks whether the recipient has seen it and no join table is needed
// (issue #64).
// ---------------------------------------------------------------------------
model Message {
  id        String    @id @default(cuid())
  jobId     String
  job       Job       @relation(fields: [jobId], references: [id])
  senderId  String
  sender    User      @relation("MessagesSent", fields: [senderId], references: [id])
  body      String
  createdAt DateTime  @default(now())
  /// Set when the recipient reads the message; null means unread for them.
  readAt    DateTime?

  // The conversation reads `WHERE jobId = ? ORDER BY createdAt`; the unread
  // count reads `WHERE jobId = ? AND readAt IS NULL`.
  @@index([jobId, createdAt])
  @@index([jobId, readAt])
}

// ---------------------------------------------------------------------------
// IndexerCursor — tracks last processed Horizon ledger per event type
// ---------------------------------------------------------------------------
model IndexerCursor {
  id          String   @id
  lastLedger  Int      @default(0)
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// IndexerDeadLetter — contract events the indexer could not apply
//
// A failing event never blocks the batch (the cursor still advances), so
// without this table a decode/persist bug would silently drop state changes.
// Rows are kept for inspection and replayed by hand after a fix.
// ---------------------------------------------------------------------------
model IndexerDeadLetter {
  /// Event id from Soroban RPC (stable across re-fetches of the same event)
  id          String   @id
  ledger      Int
  eventName   String?
  contractId  String?
  error       String
  /// Encoded Soroban event required to retry the failed dispatch.
  eventPayload Json?
  /// Incremented when the same event is recorded again (e.g. after a cursor rewind)
  attempts    Int      @default(1)
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// ChainEvent — indexed contract events, for per-user transaction history
//
// The indexer applies events to Job/Milestone/Dispute/Rating, but none of those
// rows keeps the transaction hash, so the explorer link a history view needs
// (issue #72) and a receipt needs (issue #77) cannot be rebuilt from them. This
// table records the events themselves.
//
// Keyed on the Soroban RPC event id, which is stable across re-fetches of the
// same event, so a cursor rewind upserts the row instead of duplicating history.
// ---------------------------------------------------------------------------
model ChainEvent {
  id        String   @id
  /// Escrow the event belongs to. A user's history is the events on the escrows
  /// of their jobs, so this is the lookup key. Deliberately not a foreign key:
  /// an event can arrive before the off-chain job record exists, and it is still
  /// a record of something that happened on-chain.
  escrowId  BigInt
  /// Event name from topic0, e.g. `funded`, `milestone_released` (docs/EVENTS.md).
  action    String
  /// Value the event moved, in the asset's base units, when it carries one.
  amount    Decimal?
  /// Hash of the transaction that emitted the event, for the explorer link.
  txHash    String?
  ledger    Int
  /// Ledger close time reported by RPC; falls back to the row's receipt time.
  createdAt DateTime @default(now())

  // A history query is "events for this escrow, in order".
  @@index([escrowId, ledger])
}

// ---------------------------------------------------------------------------
// AuthNonce — single-use, short-lived challenge nonces for wallet auth
// ---------------------------------------------------------------------------
model AuthNonce {
  /// Stellar address the nonce was issued to
  address   String   @id
  nonce     String
  expiresAt DateTime

  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// UserSession — active JWT sessions for token revocation (issue #172)
// ---------------------------------------------------------------------------
model UserSession {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation("UserSessions", fields: [userId], references: [id], onDelete: Cascade)
  /// Token version: incremented on logout to invalidate all tokens with lower versions
  tokenVersion Int      @default(0)
  /// Session expires at this time (JWT expiry); after this, the row can be cleaned up
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Notifications — persistent user alerts for contract and escrow events (#66)
// ---------------------------------------------------------------------------
model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation("UserNotifications", fields: [userId], references: [id])
  jobId     String?
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

enum NotificationType {
  FUNDED
  RELEASED
  DISPUTED
  RESOLVED
}

// ---------------------------------------------------------------------------
// Proposals — freelancer applications for open jobs (issue #63)
// ---------------------------------------------------------------------------
model Proposal {
  id           String         @id @default(cuid())
  jobId        String
  job          Job            @relation(fields: [jobId], references: [id])
  freelancerId String
  freelancer   User           @relation("FreelancerProposals", fields: [freelancerId], references: [id])
  coverLetter  String?
  proposedRate Decimal?
  status       ProposalStatus @default(PENDING)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([jobId, freelancerId])
  @@index([jobId])
  @@index([freelancerId])
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// ---------------------------------------------------------------------------
// Deliverables — off-chain milestone attachments (issue #65)
// ---------------------------------------------------------------------------
model Deliverable {
  id           String    @id @default(cuid())
  milestoneId  String
  milestone    Milestone @relation(fields: [milestoneId], references: [id], onDelete: Cascade)
  fileName     String
  fileUrl      String
  fileSize     Int?
  fileType     String?
  description  String?
  uploadedById String
  uploadedBy   User      @relation("UploadedDeliverables", fields: [uploadedById], references: [id])
  createdAt    DateTime  @default(now())

  @@index([milestoneId])
  @@index([uploadedById])
}
